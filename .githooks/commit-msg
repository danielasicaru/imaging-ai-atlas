#!/bin/sh
# Strips AI-attribution trailers from commit messages. See README "Repository conventions".
set -eu

msg_file="$1"

sed -E -i \
    -e '/^[[:space:]]*Co-Authored-By:/Id' \
    -e '/^[[:space:]]*Generated (with|by)/Id' \
    -e '/🤖/d' \
    "$msg_file"

# collapse any blank lines left behind at the end of the file
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$msg_file"
